    {
      "name": "2. Products Web Services",
      "item": [
        {
          "name": "GET Products - Select All (No criteria)",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/products",
              "host": ["{{baseUrl}}"],
              "path": ["products"]
            }
          }
        },
        {
          "name": "GET Products - Criteria Search (Keyword)",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/products?q=Freedom",
              "host": ["{{baseUrl}}"],
              "path": ["products"],
              "query": [{ "key": "q", "value": "Freedom" }]
            }
          }
        },
        {
          "name": "GET Products - Multi-Criteria (Grade + Category)",
          "request": {
            "method": "GET",
            "url": {
